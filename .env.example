# Transcription
# Model name as the transcription service knows it — an OpenRouter model id
# (google/gemini-3.1-flash-lite-preview) or a Whisper model on your own server
# (KBLab/kb-whisper-medium, whisper-1, Systran/faster-whisper-large-v3...).
TRANSCRIPTION_MODEL=google/gemini-3.1-flash-lite-preview

# Run transcription on a separate server/service. Leave both empty to keep using
# the OpenRouter credentials below. Any OpenAI-compatible endpoint works:
# Speaches/faster-whisper-server, whisper.cpp server, LocalAI, LM Studio,
# vLLM, Groq, OpenAI. Give the base URL up to (and including) /v1.
#   TRANSCRIPTION_BASE_URL=http://192.168.1.50:8000/v1
#   TRANSCRIPTION_API_KEY=            # many local servers need none
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=

# API shape the transcription service speaks:
#   auto  = "audio" when TRANSCRIPTION_BASE_URL is set, otherwise "chat"
#   audio = POST {base}/audio/transcriptions (OpenAI Whisper style, multipart)
#   chat  = chat completions with an input_audio part (OpenRouter audio models)
TRANSCRIPTION_API=auto

# Language hint for the "audio" API (ISO-639-1). Empty => let the service detect.
TRANSCRIPTION_LANGUAGE=sv
# Seconds to wait for a transcript — raise it for slow CPU-only Whisper boxes.
TRANSCRIPTION_TIMEOUT=600

# Local Whisper model (unused, kept for reference)
WHISPER_MODEL=KBLab/kb-whisper-medium

# LLM / OpenRouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4

# Model for podcast/radio-style audio summary scripts.
# Leave empty (or unset) to fall back to LLM_MODEL.
PODCAST_MODEL=

# TTS — used for podcast/radio-style audio summaries.
# Discover speech-output models via the OpenRouter Models page or
# the Models API with `output_modalities=speech`.
TTS_MODEL=openai/gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_FORMAT=mp3      # mp3 or pcm
TTS_SPEED=1.0       # supported by some providers only

# Default host style for audio summaries — can be overridden per request.
# default  = warm, personal "Dagboksradion" host (Sommar i P1-style)
# factual  = neutral, fact-only reading with no personal touch
# roasting = sarcastic, joking, on-the-edge roast
AUDIO_SUMMARY_STYLE=default

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=  # comma-separated Telegram user IDs (leave empty to allow all)

# Google Health API (Fitbit) daily sync — `python -m app.jobs.health_sync`.
# Fill in the client id/secret from your Google Cloud OAuth client, then run
# `python -m app.jobs.google_auth` — it mints the refresh token and writes the two
# lines below for you. NOTE: while the OAuth app is in "Testing" mode the refresh
# token expires after ~7 days; `python -m app.jobs.google_auth --check` (daily cron)
# Telegram-alerts you with a fresh consent link before that bites.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REFRESH_TOKEN=
GOOGLE_HEALTH_REFRESH_TOKEN_ISSUED=
GOOGLE_HEALTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_HEALTH_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
# Must also be an authorized redirect URI on the OAuth client in Google Cloud Console.
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8765/
# activity_and_fitness = steps/distance/energy/floors, health_metrics = heart rate, sleep = sleep.
# (There is no googlehealth.heart_rate scope — Google rejects it as invalid_scope.)
GOOGLE_HEALTH_SCOPES=https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly,https://www.googleapis.com/auth/googlehealth.health_metrics_and_measurements.readonly,https://www.googleapis.com/auth/googlehealth.sleep.readonly
GOOGLE_HEALTH_API_BASE=https://health.googleapis.com
GOOGLE_HEALTH_SOURCE=fitbit
# The API has no computed resting heart rate, so it is estimated as this percentile
# of the day's intraday heart-rate samples. 20 matches the Fitbit app within ~1 bpm;
# lower it if the synced value reads high, raise it if it reads low.
GOOGLE_HEALTH_RESTING_HR_PERCENTILE=20
# Chat id for daily sync notifications. Empty => first id in TELEGRAM_ALLOWED_USERS.
HEALTH_SYNC_NOTIFY_CHAT_ID=

# Which source the nightly `python -m app.jobs.health_sync` reads from:
#   google        = Google Health API (Fitbit), settings above
#   homeassistant = Home Assistant health sensors over its MCP server, below
HEALTH_SYNC_PROVIDER=google

# Home Assistant — needs the "Model Context Protocol Server" integration, and each
# sensor must be exposed to Assist (Settings → Voice assistants → Expose).
# The token is a long-lived access token (HA profile → Security).
# Home Assistant only has current values, so this source syncs today only (no backfill).
HOMEASSISTANT_MCP_URL=http://homeassistant.local:8123/api/mcp
HOMEASSISTANT_ACCESS_TOKEN=
HOMEASSISTANT_SOURCE=homeassistant
# Entity id (or friendly name) per health_data column; leave one empty to skip it.
HOMEASSISTANT_SENSOR_STEPS=sensor.mattias_steg
HOMEASSISTANT_SENSOR_DISTANCE=sensor.mattias_avstand
HOMEASSISTANT_SENSOR_RESTING_HR=sensor.mattias_vilopuls
# Reported in hours (8.1) and stored as minutes, on yesterday's row (last night).
HOMEASSISTANT_SENSOR_SLEEP=sensor.mattias_tid_sovande

# Storage
DATABASE_PATH=./diary.db
AUDIO_DIR=./audio
REPORTS_DIR=./reports
AUDIO_SUMMARIES_DIR=./audio/summaries

# Security — shared secret required by every /api endpoint.
# Leave empty to disable the check entirely (no auth). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Clients send it as an `X-API-Key` header (iPhone Shortcut, Open WebUI pipe,
# curl) or as `?token=...` on links the browser opens.
API_TOKEN=

# Server
HOST=0.0.0.0
PORT=8000
